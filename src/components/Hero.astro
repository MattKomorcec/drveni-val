---
import { type Lang, t, getLocalizedPath } from '../i18n/utils';
import Img from './Img.astro';
import Button from './Button.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
---

<section class="bg-navy text-white px-4 lg:px-40">
  <div class="text-center flex lg:flex-row flex-col gap-8 container">
    <div class="lg:w-2/3 w-full relative">
      <img
        src="/svg/waves.svg"
        alt=""
        width="330"
        height="145"
        class="opacity-50 hidden lg:block absolute top-[-50px] lg:left-[-300px] left-[-150px] z-0"
      />
      <h1 class="text-[42px] font-bold mb-4 z-10 text-center md:text-left mt-5 lg:mt-0" set:html={t(lang, 'hero.title')}>
      </h1>
      <div class="hidden lg:flex justify-left space-x-4 mt-8">
        <Button text={t(lang, 'hero.cta_products')} href={getLocalizedPath(lang, '/products')} variant="orange" />
        <Button text={t(lang, 'hero.cta_about')} href={getLocalizedPath(lang, '/about')} variant="transparent" />
      </div>
    </div>

    <div class="lg:w-1/3 w-full relative">
      <Img src="/images/hero_image.png" displayWidth={480} alt="Drveni Val products" class="w-full" loading="eager" fetchpriority="high" />
    </div>
  </div>

  <!-- CTA visible on mobile only -->
  <div class="lg:hidden flex flex-col text-center gap-3 mt-8 py-6">
    <Button text={t(lang, 'hero.cta_products')} href={getLocalizedPath(lang, '/products')} variant="orange" />
    <Button text={t(lang, 'hero.cta_about')} href={getLocalizedPath(lang, '/about')} variant="transparent" />
  </div>
</section>

<div class="bg-[#DEF2FC]">
  <img src="/images/wave_navy_top_left.png" alt="" width="100%" height="100%" />
</div>
