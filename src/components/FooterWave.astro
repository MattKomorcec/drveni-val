---
interface Props {
  bgColor?: string;
}

const { bgColor = 'bg-white' } = Astro.props;
---

<div class:list={['relative footer-wave-container', bgColor]}>
  <img src="/images/wave_navy_bottom_left.png" alt="" width="1440" height="121" class="w-full z-10" />
  <img src="/svg/boat-3.svg" width="100" height="100" alt="" />
  <img src="/svg/Ship1.svg" width="100" height="100" alt="" class="z-0" />
</div>

<style>
  .footer-wave-container {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    grid-template-rows: 1fr 1fr;
  }

  .footer-wave-container img:first-child {
    grid-column: 1 / 13;
    grid-row: 2;
  }

  .footer-wave-container img:nth-child(2) {
    grid-column: 3;
    grid-row: 2;
    width: 80%;
    position: relative;
    bottom: 10%;
  }

  .footer-wave-container img:last-child {
    grid-column: 11;
    grid-row: 1;
    width: 80%;
    bottom: -10px;
    position: relative;
  }
</style>
