---
import { type Lang, t } from '../i18n/utils';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;

const reviews = [
  {
    image: '/images/review_anja.jpg',
    text: 'reviews.review1_text',
    author: 'Anja Kolacio, Hrvatska',
  },
  {
    image: '/images/review_1_image.png',
    text: 'reviews.review2_text',
    author: 'Lidija Rom, Slovenija',
  },
];
---

<div class="px-4 md:px-40 py-20">
  <h2 class="text-navy text-center text-[44px] mb-20">{t(lang, 'reviews.title')}</h2>
  <div class="relative w-full max-w-4xl mx-auto border-[15px] border-warm-red">
    <img
      src="/svg/icon_clothes_pin.svg"
      alt=""
      width="27"
      height="81"
      class="absolute top-[-45px] left-1/2"
    />
    <div class="overflow-hidden relative">
      <div class="carousel-slide flex transition-transform duration-500">
        {reviews.map((review) => (
          <div class="w-full flex-shrink-0 flex flex-col md:flex-row p-8 pb-16">
            <div class="md:w-1/3 w-full">
              <img src={review.image} class="w-full" alt={`Review by ${review.author}`} width="100" height="100" />
            </div>
            <div class="mt-4 md:mt-0 md:ml-4 text-navy leading-8 md:w-2/3 w-full">
              <p>{t(lang, review.text)}</p>
              <p class="font-semibold mt-2 italic">{review.author}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>

  <div class="flex justify-center mt-14">
    <button class="carousel-button prev mr-8 cursor-pointer" aria-label="Previous review">
      <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
      </svg>
    </button>

    <ul class="flex items-center justify-between gap-4" aria-label="Review slides">
      {reviews.map((_, i) => (
        <li class:list={['w-[8px] h-[8px] rounded-full carousel-circle', i === 0 && 'selected']} aria-current={i === 0 ? 'true' : undefined} />
      ))}
    </ul>

    <button class="carousel-button next ml-8 cursor-pointer" aria-label="Next review">
      <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
      </svg>
    </button>
  </div>
</div>

<div class="bg-navy relative">
  <img
    src="/svg/house-group-02.svg"
    width="174"
    height="100"
    alt=""
    class="absolute left-[15%] bottom-[-15%] max-w-[200px] md:w-auto hidden lg:block"
  />
  <img
    src="/images/clothes_hanger.png"
    width="300"
    height="100"
    alt=""
    class="absolute max-w-[300px] right-1/4 bottom-[45%] hidden lg:block"
  />
  <img src="/images/wave_white_top_right.png" alt="" width="100%" height="100%" />
</div>

<style>
  .carousel-slide {
    transition: transform 0.5s ease-in-out;
  }

  .carousel-button.disabled {
    color: grey;
    cursor: not-allowed;
  }

  .carousel-circle {
    background-color: var(--color-grey);
  }

  .carousel-circle.selected {
    background-color: var(--color-navy);
  }
</style>

<script>
  const slides = document.querySelectorAll('.carousel-slide > div');
  const totalSlides = slides.length;
  let currentIndex = 0;

  const updateCarousel = () => {
    const offset = -currentIndex * 100;
    const slide = document.querySelector('.carousel-slide') as HTMLElement;
    if (slide) slide.style.transform = `translateX(${offset}%)`;
    updateButtons();
    updateCircles();
  };

  const updateButtons = () => {
    const prevButton = document.querySelector('.carousel-button.prev');
    const nextButton = document.querySelector('.carousel-button.next');

    if (currentIndex === 0) {
      prevButton?.classList.add('disabled');
      nextButton?.classList.remove('disabled');
    } else if (currentIndex === totalSlides - 1) {
      nextButton?.classList.add('disabled');
      prevButton?.classList.remove('disabled');
    } else {
      prevButton?.classList.remove('disabled');
      nextButton?.classList.remove('disabled');
    }
  };

  const updateCircles = () => {
    const circles = document.querySelectorAll('.carousel-circle');
    circles.forEach((circle, i) => {
      circle.classList.toggle('selected', i === currentIndex);
    });
  };

  document.querySelector('.carousel-button.next')?.addEventListener('click', () => {
    if (currentIndex < totalSlides - 1) {
      currentIndex++;
      updateCarousel();
    }
  });

  document.querySelector('.carousel-button.prev')?.addEventListener('click', () => {
    if (currentIndex > 0) {
      currentIndex--;
      updateCarousel();
    }
  });

  updateButtons();
</script>
