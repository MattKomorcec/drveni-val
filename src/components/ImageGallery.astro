---
import { type Lang, t } from '../i18n/utils';
import Img from './Img.astro';
import Button from './Button.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
---

<div class="bg-navy px-4 md:px-20 py-20">
  <h2 class="text-white text-center text-[44px] mb-20">{t(lang, 'gallery.title')}</h2>

  <div
    class="mb-4 gap-4 mx-auto flex flex-col justify-between items-end w-full lg:grid lg:justify-items-end"
    style="grid-template-columns: 1fr 1fr;"
  >
    <Img
      src="/images/gallery_zeljka_komorcec.jpg"
      displayWidth={640}
      alt="Željka Komorčec holding a driftwood painting"
      class="object-contain w-full"
    />
    <div class="flex flex-wrap gap-4 h-full justify-between">
      <Img
        src="/images/gallery_painting4.jpg"
        displayWidth={640}
        alt="Driftwood paintings on the wall of the Drveni Val studio"
        class="object-contain w-full"
      />
      <Img
        src="/images/gallery_next_to_entrance.jpg"
        displayWidth={640}
        alt="Entrance of the Drveni Val studio in Novi Vinodolski"
        class="object-contain w-full"
      />
    </div>
  </div>

  <div class="gap-4 flex flex-col items-center lg:grid" style="grid-template-columns: 1fr 1fr 1fr;">
    <Img src="/images/gallery_painting1.png" displayWidth={430} alt="Painting driftwood" class="object-contain w-full" />
    <Img src="/images/gallery_painting2.jpg" displayWidth={430} alt="Painting driftwood" class="object-contain w-full" />
    <Img src="/images/gallery_painting3.jpeg" displayWidth={430} alt="Painting driftwood" class="object-contain w-full" />
  </div>

  <div class="mt-32 mb-32 flex justify-center">
    <Button
      text={t(lang, 'gallery.cta')}
      href="https://www.instagram.com/drveni_val/"
      variant="orange"
      target="_blank"
    />
  </div>
</div>

<div class="bg-white relative">
  <img
    src="/svg/lighthouse_full.svg"
    width="99"
    height="290"
    alt=""
    class="absolute left-[15%] bottom-[-15%] md:w-auto hidden lg:block"
  />
  <img src="/images/wave_navy_top_right.png" alt="" width="100%" height="100%" />
</div>
